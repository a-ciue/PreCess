# Draft only: this file is not included by the parent CMakeLists.txt yet.
# It documents how TetGen can be built as an internal static library for PreCess.

set(TETGEN_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/tetgen")

add_library(TetGenInternal STATIC
    "${TETGEN_SOURCE_DIR}/tetgen.cxx"
    "${TETGEN_SOURCE_DIR}/predicates.cxx"
)

target_compile_definitions(TetGenInternal
    PUBLIC TETLIBRARY
)

target_include_directories(TetGenInternal
    PUBLIC "${TETGEN_SOURCE_DIR}"
)

# TetGen's own CMake names the library target `tet` and also builds the exe.
# For PreCess plugin integration we only need the library target.

