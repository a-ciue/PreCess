@PACKAGE_INIT@
# PreCess CMake 包入口：find_package(PreCess) 一次性导入模型层目标（PreCess::Base）、
# 传递依赖（spdlog/OCCT/VTK/Qt6）与插件构建 API（PreCessPlugin.cmake）。
#
# 组件（可选，服务可选能力；命名契约：组件名与其导入目标同名对应）：
#   Python                      内嵌解释器宿主（PreCess::Python，仅真实 Python 构建提供）
#   Tests                       插件测试 API（工具组件、不产生目标：PreCessPluginTesting.cmake + Catch2）
include(CMakeFindDependencyMacro)

# RelWithDebInfo 消费者取三方 SHARED 导入库时一律用 Release 版（不设时 CMake 的
# 配置回退可能落到 DEBUG 版，如 spdlogd.dll——运行期宿主无该 Debug DLL，插件加载
# 即依赖断链失败）；消费者已显式设置的映射保持不覆盖
if(NOT DEFINED CMAKE_MAP_IMPORTED_CONFIG_RELWITHDEBINFO)
    set(CMAKE_MAP_IMPORTED_CONFIG_RELWITHDEBINFO "Release;RelWithDebInfo;MinSizeRel;NoConfig")
endif()

# ① 三方包查找引导：指向 PreCess 构建时的同一实例（可重定位安装时本文件不随包；
#    helpers 带 NOT DEFINED 守卫，用户显式 -D <pkg>_DIR 始终最高优先）
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/PreCess-find-package-helpers.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/PreCess-find-package-helpers.cmake")
endif()

# ② 传递依赖：与 PreCess 构建时同源、同组件基线
find_dependency(spdlog CONFIG)
find_dependency(OpenCASCADE)
find_dependency(VTK COMPONENTS CommonColor CommonCore GUISupportQtQuick
                       InteractionStyle FiltersVerdict RenderingAnnotation)
find_dependency(Qt6 COMPONENTS Core)

# ③ 导入项目目标（PreCess::Base 等）
include("${CMAKE_CURRENT_LIST_DIR}/PreCessTargets.cmake")

# ④ 版本钉对 + ABI 指纹校验：三方实例与编译器须与 PreCess 构建时一致
include("${CMAKE_CURRENT_LIST_DIR}/PreCessABI.cmake")
_precess_check_third_party_versions()

# ⑤ 运行时插件目录（相对包位置解析，可重定位；可经缓存变量覆盖）
get_filename_component(PRECESS_PLUGIN_INSTALL_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/../plugins" ABSOLUTE)
set(PRECESS_PLUGIN_INSTALL_DIR "${PRECESS_PLUGIN_INSTALL_DIR}" CACHE PATH
    "外部插件默认安装目录（PreCess 运行时扫描路径）")

# ⑥ 插件构建 API 与组件解析
# SDK 导入统一声明外部插件构建语境，与主工程入口的 TRUE 对应。
set(PRECESS_PLUGIN_IN_TREE FALSE)
# 边界内自定义 Find 模块随包安装（Findfreetype）：加入模块路径使插件工程可直接
# find_package(freetype) 命中与 PreCess 同款实现；许可证边界外的 Find 模块
# 刻意不随包（如 tetgen 的 Find 模块随 ZenithGridToolkit 工程自带）——
# 相关依赖由插件工程自行查找并承担许可证义务
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/PreCessPlugin.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PreCessModules.cmake")

set(PRECESS_VERSION "@PROJECT_VERSION@")
set(PRECESS_QT_MAJOR "@VTK_QT_VERSION@")
set(PRECESS_USE_PYTHON "@PRECESS_WITH_PYTHON@")
set(PRECESS_PLUGIN_SUBDIR "plugins")

precess_modules_resolve_components()
check_required_components(PreCess)
