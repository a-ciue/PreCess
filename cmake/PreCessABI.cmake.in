# PreCess ABI 指纹：构建期记录，插件配置期比对（precess_add_*_plugin 自动调用）。
# 目标：把"版本错配运行时崩溃/静默数据损坏"提前到配置期失败，给出明确错误。
# 全部校验可经 -DPRECESS_ALLOW_ABI_MISMATCH=ON 降级为警告（显式承担风险时用）。
set(PRECESS_ABI_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(PRECESS_ABI_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(PRECESS_ABI_MSVC_TOOLSET "@MSVC_TOOLSET_VERSION@")
set(PRECESS_ABI_CXX_STANDARD "@CMAKE_CXX_STANDARD@")
set(PRECESS_ABI_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set(PRECESS_ABI_MSVC_RUNTIME "@CMAKE_MSVC_RUNTIME_LIBRARY@")
set(PRECESS_ABI_SPDLOG_VERSION "@spdlog_VERSION@")
set(PRECESS_ABI_VTK_VERSION "@VTK_VERSION@")
set(PRECESS_ABI_OCCT_VERSION "@OpenCASCADE_VERSION@")
set(PRECESS_ABI_QT_VERSION "@Qt6_VERSION@")

option(PRECESS_ALLOW_ABI_MISMATCH "跳过 ABI 校验硬失败（降级为警告）——确认风险后手动开启" OFF)

# 编译器与工具链指纹校验（插件目标创建前调用）
function(_precess_check_abi)
    if(PRECESS_ALLOW_ABI_MISMATCH)
        message(WARNING "PRECESS_ALLOW_ABI_MISMATCH=ON：已跳过 PreCess ABI 硬校验（自行承担崩溃/数据损坏风险）")
        return()
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "${PRECESS_ABI_COMPILER_ID}")
        message(FATAL_ERROR
            "编译器不匹配：PreCess 构建于 ${PRECESS_ABI_COMPILER_ID}，"
            "当前为 ${CMAKE_CXX_COMPILER_ID}。插件必须与 PreCess 同编译器构建（C++ ABI 不兼容）")
    endif()
    # 版本校验到主.次：补丁级升级不改变 ABI（MSVC 同 toolset 14.x、GCC/Clang 同主.次均二进制兼容），
    # 全段相等会误杀 VS 微更新；跨主.次仍硬失败
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _precess_abi_ver "${CMAKE_CXX_COMPILER_VERSION}")
    string(REGEX MATCH "^[0-9]+\\.[0-9]+" _precess_abi_ref "${PRECESS_ABI_COMPILER_VERSION}")
    if(NOT "${_precess_abi_ver}" VERSION_EQUAL "${_precess_abi_ref}")
        message(FATAL_ERROR
            "编译器主.次版本不匹配：PreCess 构建于 ${PRECESS_ABI_COMPILER_ID} "
            "${PRECESS_ABI_COMPILER_VERSION}，当前为 ${CMAKE_CXX_COMPILER_VERSION}。"
            "请使用同主.次编译器构建插件（补丁级可不同）；"
            "确认无误可 -DPRECESS_ALLOW_ABI_MISMATCH=ON 强制继续（不建议）")
    endif()
    if(MSVC AND NOT "${MSVC_TOOLSET_VERSION}" STREQUAL "${PRECESS_ABI_MSVC_TOOLSET}")
        message(FATAL_ERROR
            "MSVC 工具集不匹配：PreCess 构建于 v${PRECESS_ABI_MSVC_TOOLSET}，"
            "当前为 v${MSVC_TOOLSET_VERSION}")
    endif()
    if(NOT "${CMAKE_CXX_STANDARD}" STREQUAL "${PRECESS_ABI_CXX_STANDARD}")
        message(FATAL_ERROR
            "C++ 标准不匹配：PreCess 构建于 C++${PRECESS_ABI_CXX_STANDARD}，当前为 C++${CMAKE_CXX_STANDARD}")
    endif()
    # CRT 与构建配置：MSVC 下 Debug/Release 混链 = _ITERATOR_DEBUG_LEVEL 2↔0，运行期堆损坏；
    # 动态 CRT(/MD) 与静态 CRT(/MT) 混链 = 跨模块 new/delete 错配（P0 缺口补齐，2026-09-23）
    if(MSVC)
        if(NOT "${CMAKE_MSVC_RUNTIME_LIBRARY}" STREQUAL "${PRECESS_ABI_MSVC_RUNTIME}")
            message(FATAL_ERROR
                "MSVC 运行库（CRT）不匹配：PreCess 为 \"${PRECESS_ABI_MSVC_RUNTIME}\"（空=默认动态 CRT），"
                "当前为 \"${CMAKE_MSVC_RUNTIME_LIBRARY}\"。/MD 与 /MT 混链会导致跨模块 new/delete 错配")
        endif()
        # 单配置生成器（Ninja 等）下可比构建配置；多配置生成器生成期无单一配置，退化为 CRT 检查
        if(NOT "${PRECESS_ABI_BUILD_TYPE}" STREQUAL "" AND "${CMAKE_CONFIGURATION_TYPES}" STREQUAL "")
            if(NOT "${CMAKE_BUILD_TYPE}" STREQUAL "${PRECESS_ABI_BUILD_TYPE}")
                message(FATAL_ERROR
                    "构建配置不匹配：PreCess 库为 ${PRECESS_ABI_BUILD_TYPE}，当前 CMAKE_BUILD_TYPE="
                    "\"${CMAKE_BUILD_TYPE}\"。Debug/Release 混链（_ITERATOR_DEBUG_LEVEL 不同）会在运行期堆损坏；"
                    "请以 -DCMAKE_BUILD_TYPE=${PRECESS_ABI_BUILD_TYPE} 构建插件")
            endif()
        endif()
    endif()
endfunction()

# 三方库版本钉对：插件侧命中的实例必须与 PreCess 构建时一致。
# 分级依据三方互依拓扑（docs/plugin-sdk-design.md §5.1）：
# - VTK/Qt/OCCT 属"单实例强约束"且被下游二进制锁死（gmsh 硬锁 OCCT；TKIVtk 锁 VTK -9.6 前缀）→ FATAL
# - spdlog 无下游锁、ABI 面窄 → WARN
function(_precess_check_third_party_versions)
    if(PRECESS_ALLOW_ABI_MISMATCH)
        return()
    endif()
    if(NOT "${PRECESS_ABI_VTK_VERSION}" STREQUAL "" AND DEFINED VTK_VERSION
            AND NOT VTK_VERSION VERSION_EQUAL "${PRECESS_ABI_VTK_VERSION}")
        message(FATAL_ERROR
            "VTK 版本不匹配：PreCess 构建于 ${PRECESS_ABI_VTK_VERSION}，当前命中 ${VTK_VERSION}。"
            "插件须使用 PreCess 构建时的同一 VTK 实例（见 PreCess-find-package-helpers.cmake）")
    endif()
    if(NOT "${PRECESS_ABI_QT_VERSION}" STREQUAL "" AND DEFINED Qt6_VERSION
            AND NOT Qt6_VERSION VERSION_EQUAL "${PRECESS_ABI_QT_VERSION}")
        message(FATAL_ERROR
            "Qt 版本不匹配：PreCess 构建于 ${PRECESS_ABI_QT_VERSION}，当前命中 ${Qt6_VERSION}。"
            "插件须使用 PreCess 构建时的同一 Qt 实例")
    endif()
    if(NOT "${PRECESS_ABI_OCCT_VERSION}" STREQUAL "" AND DEFINED OpenCASCADE_VERSION
            AND NOT OpenCASCADE_VERSION VERSION_EQUAL "${PRECESS_ABI_OCCT_VERSION}")
        message(FATAL_ERROR
            "OpenCASCADE 版本不匹配：PreCess 构建于 ${PRECESS_ABI_OCCT_VERSION}，当前命中 ${OpenCASCADE_VERSION}。"
            "OCCT 是三方互依的重耦合节点：gmsh 二进制硬锁 TK*、TKIVtk（VIS）锁 VTK 且与 OCCT 对象跨 DLL 传递，"
            "版本错配为运行期崩溃级。升级 OCCT 须连带核对 gmsh/TKIVtk 对应关系")
    endif()
    if(NOT "${PRECESS_ABI_SPDLOG_VERSION}" STREQUAL "" AND DEFINED spdlog_VERSION
            AND NOT spdlog_VERSION VERSION_EQUAL "${PRECESS_ABI_SPDLOG_VERSION}")
        message(WARNING
            "spdlog 版本不一致：PreCess 构建于 ${PRECESS_ABI_SPDLOG_VERSION}，"
            "当前命中 ${spdlog_VERSION}")
    endif()
endfunction()
